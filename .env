# SmartLift Configuration Example
# Copy to .env and configure as needed

# Node.js API Service
NODE_ENV=development
PORT=3000

# MongoDB Connection
# Set to your local MongoDB instance or leave default for in-memory fallback
MONGODB_URI=mongodb://127.0.0.1:27017/smartlift

# Python ML & Computer Vision FastAPI Service
PYTHON_SERVICE_URL=http://127.0.0.1:8000
PYTHON_SERVICE_PORT=8000
PYTHON_SERVICE_HOST=127.0.0.1

# Simulation Parameters
TOTAL_FLOORS=10
ELEVATOR_CAPACITY=12
SKIP_RETURN_THRESHOLD=3
DEMAND_PREDICTION_HORIZON_MINUTES=5
RANDOM_SEED=42

# Computer Vision Detector Settings
CV_CONFIDENCE_THRESHOLD=0.35
CV_DETECTOR_TYPE=hog_fallback
